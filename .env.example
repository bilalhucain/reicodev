# ─────────────────────────────────────────────────────────
# Reicodev — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────

# Site URL — used for sitemap, OG tags and absolute URLs
# Local:      http://localhost:3000
# Production: https://reicodev.com
NEXT_PUBLIC_SITE_URL=https://reicodev.com

# Resend API key — used by /api/contact and /api/quote email routes
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# WordPress CMS backend URL (no trailing slash)
# Leave blank if not using the WordPress integration
# Local:      http://localhost/reicodev-cms
# Production: https://cms.reicodev.com
WORDPRESS_URL=

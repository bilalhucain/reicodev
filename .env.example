# ─────────────────────────────────────────────────────────
# Reicodev — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────

# WordPress backend URL (no trailing slash)
# Local:      http://localhost/reicodev-cms
# Production: https://cms.reicodev.com
NEXT_PUBLIC_SITE_URL=https://reicodev.com

# Optional: Site URL (used for absolute URLs in sitemap/OG)
NEXT_PUBLIC_SITE_URL=https://reicodev.com
